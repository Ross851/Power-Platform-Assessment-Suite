# Power Platform Assessment Suite - Environment Variables

# Base URL for the application (used for SEO metadata)
# Set this to your deployment URL
# Examples:
#   Production: https://assessment.yourdomain.com
#   Staging: https://assessment-staging.yourdomain.com
#   Development: http://localhost:3000 (default if not set)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ⚠️ WARNING: Google Drive Integration - INSECURE BY DESIGN
# The current Google Drive integration exposes API keys in the client bundle.
# This is a CRITICAL SECURITY RISK and should NOT be used in production.
#
# If you must use Google Drive:
# 1. Implement a proper backend API route (app/api/google-drive/*)
# 2. Store credentials server-side only
# 3. Use OAuth 2.0 with proper user authentication
# 4. Restrict API keys with HTTP Referrer restrictions in Google Cloud Console
#
# For now, these are DISABLED and not recommended:
# NEXT_PUBLIC_GOOGLE_API_KEY=your_api_key_here
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here

# Note: Any variable prefixed with NEXT_PUBLIC_ will be exposed to the browser
# NEVER put secrets, API keys, or sensitive data in NEXT_PUBLIC_ variables
